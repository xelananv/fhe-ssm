+// ---- K768 PATCH (fhe-ssm-research, 2026-09-18) ---------------------------------------------------
+// Run-time switch for the approximate modular reduction of the UNIFORM_TERNARY CKKS bootstrap.
+//   OPENFHE_BOOT_UNIFORM_EXT=1 -> g_coefficientsUniformExt (degree 118) with K_UNIFORMEXT = 768
+//   unset / any other value    -> the stock selection (g_coefficientsUniform, degree 88, K_UNIFORM = 512,
+//                                 unless composite scaling already asks for the Ext table)
+// Read with std::getenv at EVERY selection site, so that ONE build serves both arms of an A/B.
+bool UniformExtRequestedByEnv() {
+    const char* v = std::getenv("OPENFHE_BOOT_UNIFORM_EXT");
+    return (v != nullptr) && (v[0] == '1') && (v[1] == '\0');
+}
+
+// One line on stderr, once per process and ONLY when the switch is on: what the library actually selected
+// (degree read from the vector in use, k from the variable in use), so that a run record can prove the arm.
+void NoteUniformExtOnce(const char* site, size_t degree, double k) {
+    static bool noted = false;
+    if (!noted) {
+        noted = true;
+        std::cerr << "[openfhe-k768-patch] " << site << ": OPENFHE_BOOT_UNIFORM_EXT=1 -> Chebyshev degree " << degree
+                  << ", K = " << k << std::endl;
+    }
+}
+
