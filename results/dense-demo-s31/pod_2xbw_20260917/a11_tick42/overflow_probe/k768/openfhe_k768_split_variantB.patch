+// ---- K768 PATCH, part B: where the division by K = 768 = 3 * 2^8 is done -----------------------------
+// The stock code divides the raised ciphertext by K with ONE scalar constant, pre / (K * N). EvalMult by a double
+// encodes that constant as round(c * SF) / SF (ckksrns-leveledshe.cpp, GetElementForEvalMult), SF ~ 2^59. For
+// K = 512 the constant is a power of two and the rounding is (almost) exact; for K = 768 it is 1/(3 * 2^m), c * SF is
+// ~ 2^37/3 at N = 2^13 (2^33/3 at N = 2^17) and the rounding error of ~1/3 is a RELATIVE scale error of the input of
+// the sine, eta ~ 7e-12 at N = 2^13 (~1.2e-10 at N = 2^17): every coefficient's overflow I is seen as I * (1 + eta).
+//   OPENFHE_BOOT_UNIFORM_EXT_SPLIT=1 (only with OPENFHE_BOOT_UNIFORM_EXT=1) folds the odd part of K (the 3) into the
+//   CoeffsToSlots precomputation (scaleEnc = pre / 3, exactly as the sparse cases fold their whole K there) and leaves
+//   the scalar constant pre / (256 * N), a power of two. Same depth, same keys, same level budget.
+bool UniformExtSplitRequestedByEnv() {
+    const char* v = std::getenv("OPENFHE_BOOT_UNIFORM_EXT_SPLIT");
+    return UniformExtRequestedByEnv() && (v != nullptr) && (v[0] == '1') && (v[1] == '\0');
+}
+constexpr double K_UNIFORMEXT_ODD_PART = 3.0;   // 768 = 3 * 256
+
 // One line on stderr, once per process and ONLY when the switch is on: what the library actually selected
 // (degree read from the vector in use, k from the variable in use), so that a run record can prove the arm.
 void NoteUniformExtOnce(const char* site, size_t degree, double k) {
@@ -94,7 +109,10 @@
