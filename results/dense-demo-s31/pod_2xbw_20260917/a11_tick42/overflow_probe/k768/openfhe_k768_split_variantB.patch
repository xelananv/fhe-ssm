-                  << ", K = " << k << std::endl;
+                  << ", K in the scalar constant = " << k
+                  << (UniformExtSplitRequestedByEnv() ? " (OPENFHE_BOOT_UNIFORM_EXT_SPLIT=1: the factor 3 is in CoeffsToSlots)" :
+                                                        " (no split)")
+                  << std::endl;
     }
 }
 
