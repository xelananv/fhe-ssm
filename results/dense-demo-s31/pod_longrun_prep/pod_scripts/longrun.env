# Long autoregressive run -- pod environment (source before every script in this directory).
export DEVICES=0,1 LANES_BLOCK=1 ENC_THREADS=24 KEYS_POD=/root/demo/keys_pod_r17
export BINX=/root/fhe-main-demo/build-demo/gpu_real_model_x
export PATH=/usr/local/cuda-12.9/bin:/usr/local/cuda/bin:$PATH
export BUSY_WAIT=1
# K1 patch: the library's extended bootstrap table (K = 768, degree 118). Inherited by every server process started below.
# Set to 0 to run the stock table (K = 512) on the SAME binary (the A/B of cell 7).
#   1 = variant A (one scalar 1/(768 N)); split = variant B (scalar 1/(256 N), the 3 inside the CoeffsToSlots plaintexts; needs the
#   OpenFHE patch O1 in the build, otherwise the library falls back to A and prints splitAskedButOpenfheLacksO1:true).
# Precedence: an explicit environment value > /root/demo/BOOT_ARM (written by boot_arms_selftest.sh, cell 1b) > 1.
if [ -z "${FIDESLIB_BOOT_UNIFORM_EXT:-}" ] && [ -s /root/demo/BOOT_ARM ]; then . /root/demo/BOOT_ARM; fi
export FIDESLIB_BOOT_UNIFORM_EXT=${FIDESLIB_BOOT_UNIFORM_EXT:-1}
# Frozen flags of the long run. --newton-robust 0.1 12: the offline free-running emulation (freerun_check/) needs a window of
# [0.67 lo, 19.6 hi] on the final norm; 0.3/8 (take 9) diverges on lane 40 from tick ~37-118; 0.1/12 converges to 7e-13 on the
# greedy and the three perturbed 300-token trajectories and its window reaches ~80x hi.
export FROZEN_LONG="--canonical-carry --periodic-encode --drop-wv 7 --drop-wkr 4 --drop-wout 7 --drop-win 4 --newton-robust 0.1 12"
export X2_LONG="--pt-cache --pt-cache-verify --pt-cache-max-gb 28"
export STORE_LONG=/root/demo/store_pbd430a_r17_xd12_lanesblock_canon_nr0112.bin
export PROMPTS_LONG=${PROMPTS_LONG:-/root/demo/longrun_prompts64.txt}   # 2026-09-19: the selected mix (16 long / 16 medium / 16 short reading / 16 standard short; pod_longrun_20260919/prompt_select/); fallback: /root/src/results/dense-demo-s31/sessions/demo_prompts_64.txt
export EXTRA_FLAGS="--canonical-carry" STORE=$STORE_LONG
# 2026-09-19: the CLIENT's decoding rule for the free-running lanes (spec_decode/decode_policy.py). Greedy argmax makes this 430M model
# repeat itself within ~20 words on every prompt tried; the deterministic rule below does not, costs the server nothing and keeps the
# FHE-vs-plaintext comparison exact (same rule on both logits, same history). Empty = greedy.
export DECODE_ARGS="${DECODE_ARGS---decode-policy norepeat --rep-penalty 1.3 --rep-window 64 --no-repeat-ngram 4}"
