+// fhe-ssm O1 -- opt-in, default OFF. FIDESLIB_BOOT_UNIFORM_EXT=split (the SAME variable FIDESlib's RawCiphertext.cu reads, so the two
+// libraries cannot disagree) folds the odd part of K_UNIFORMEXT = 768 = 3 * 2^8 into the CoeffsToSlots precomputation of a
+// UNIFORM_TERNARY context: scaleEnc = pre / 3, the place where the sparse cases fold their whole K. The GPU bootstrap then divides
+// the raised ciphertext by the power of two 256 * N. Why: EvalMult by a double encodes the constant as round(c * SF) / SF; for
+// c = pre / (768 * N) that rounding is a relative scale error of the sine's input (+7.2e-12 at N = 2^13, measured on CPU as an error
+// linear in every coefficient's overflow; +9.5e-11 at N = 2^17 by the same arithmetic), for a power of two it is what the stock
+// K = 512 path has. Same depth, same keys, same level budget. Any other value of the variable (unset, 0, 1): stock behaviour.
+double BootUniformScaleEncDivisorFromEnv() {
+    const char* v    = std::getenv("FIDESLIB_BOOT_UNIFORM_EXT");
+    const bool split = (v != nullptr) && (std::strcmp(v, "split") == 0);
+    static bool noted = false;
+    if (split && !noted) {
+        noted = true;
+        std::cout << "{\"openfheBootScaleEnc\":\"pre/3\",\"oddPartOfK\":3,\"env\":\"FIDESLIB_BOOT_UNIFORM_EXT=split\"}" << std::endl;
+    }
+    return split ? 3.0 : 1.0;
+}
