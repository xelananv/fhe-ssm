+/**
+ * TEST INSTRUMENT, empty by default (then ModRaise does no extra work and behaves exactly as before).
+ * When a callback is set, ModRaise hands it a host copy of limb 0 (the residues modulo q0 = prime[0]) of c0 and c1,
+ * each taken right after its INTT, i.e. the coefficient-representation array that broadcastLimb0() lifts to the
+ * other limbs: after the scale adjustment / rescale / dropToLevel(0) (and the sparse-encapsulation key switch, if
+ * that mode is on), before grow(). evalRepresentation is false for that array (natural coefficient order, values
+ * in [0, q0)). The call is synchronous on the calling thread and every device is synchronized first; the pointers
+ * are valid only during the call. A caller that holds a TEST secret s can compute the mod-raise overflow
+ * I = round(([c0]_q0 + [c1]_q0 * s) / q0) with [.]_q0 the centered residue (v > q0/2 -> v - q0, as SwitchModulus).
+ */
+#define FIDESLIB_HAS_BOOT_PRERAISE_HOOK 1
+using BootPreRaiseHook = std::function<void(const uint64_t* c0, const uint64_t* c1, size_t N, uint64_t q0, bool evalRepresentation)>;
+extern BootPreRaiseHook g_bootPreRaiseHook;
