+/** g_bootPreRaiseHook helper: blocking host copy of every limb of a level-0 polynomial, i.e. of limb 0 alone. */
+static void bootPreRaiseFetch(RNSPoly& poly, std::vector<std::vector<uint64_t>>& out) {
+	int prevDevice = 0;
+	cudaGetDevice(&prevDevice);
+	for (auto& part : poly.GPU) {
+		cudaSetDevice(part.device);
+		cudaDeviceSynchronize();
+	}
+	poly.store(out); // RNSPoly::store: level + 1 limbs, each on its own device, stream-synchronized
+	cudaSetDevice(prevDevice);
+}
