+// ---- K3 (2026-09-18): the arithmetic of --boot-record (TEST-KEY INSTRUMENT; nothing here runs without the flag).
+// For the one-limb ciphertext (c0, c1) that FIDESlib's ModRaise is about to lift, the overflow polynomial is
+//   I = round(([c0] + [c1]*s) / q0)   over Z[X]/(X^N + 1),
+// [.] the centered residue mod q0 (v > q0>>1 -> v - q0: the lift FIDESlib's SwitchModulus performs, Rescale.cuh:44-64)
+// and s the ternary secret. The negacyclic product runs in double precision through a self-contained radix-2 complex
+// FFT with the twist zeta^k, zeta = exp(i*pi/N): the operands are c1/q0 in [-1/2, 1/2] and s in {-1, 0, 1}, so the
+// result is I + m/q0 with an absolute error ~1e-13 at N = 2^17 (a Python transliteration of exactly these loops was
+// checked against exact integers: results/dense-demo-s31/pod_longrun_prep/reports/k3_recorder_arithmetic_check.py).
+// maxFrac = max_j |x_j - round(x_j)| is the instrument's self-check: it is the message m/q0 (small, a few 1e-2 at most)
+// when the key, the modulus and the coefficient order are right, and ~0.5 when any of them is wrong.
+struct FheSsmNegacyclic {
+    size_t N = 0;
+    std::vector<double> twRe, twIm;   // zeta^k, k < N
+    std::vector<double> wRe, wIm;     // exp(-2*pi*i*k/N), k < N/2
+    std::vector<uint32_t> rev;        // bit-reversal permutation
+    std::vector<double> sRe, sIm;     // FFT(twist(s)), set once by setSecret
+    std::vector<double> aRe, aIm;     // scratch
+    struct Stats { long long maxI = 0, over512 = 0, nonCanon = 0; double rmsI = 0.0, maxFrac = 0.0; };
+    bool init(size_t n) {
+        if (n < 2 || (n & (n - 1)) != 0) return false;
+        N = n;
+        int logN = 0;
+        while (((size_t)1 << logN) < n) logN++;
+        const double kPi = 3.14159265358979323846;
+        twRe.resize(n); twIm.resize(n); wRe.resize(n / 2); wIm.resize(n / 2); rev.assign(n, 0u);
+        for (size_t k = 0; k < n; k++) {
+            const double a = kPi * (double)k / (double)n;
+            twRe[k] = std::cos(a); twIm[k] = std::sin(a);
+        }
+        for (size_t k = 0; k < n / 2; k++) {
+            const double a = 2.0 * kPi * (double)k / (double)n;
+            wRe[k] = std::cos(a); wIm[k] = -std::sin(a);
+        }
+        for (size_t i = 1; i < n; i++)
+            rev[i] = (rev[i >> 1] >> 1) | (uint32_t)((i & 1) << (logN - 1));
+        aRe.assign(n, 0.0); aIm.assign(n, 0.0);
+        return true;
+    }
+    void fft(std::vector<double>& re, std::vector<double>& im, bool inverse) const {
+        const size_t n = N;
+        const double sgn = inverse ? -1.0 : 1.0;
+        for (size_t i = 0; i < n; i++) {
+            const size_t j = rev[i];
+            if (i < j) { std::swap(re[i], re[j]); std::swap(im[i], im[j]); }
+        }
+        for (size_t len = 2; len <= n; len <<= 1) {
+            const size_t hl = len >> 1, step = n / len;
+            for (size_t i = 0; i < n; i += len)
+                for (size_t j = 0; j < hl; j++) {
+                    const double wr = wRe[j * step], wi = sgn * wIm[j * step];
+                    const size_t a = i + j, b = a + hl;
+                    const double xr = re[b] * wr - im[b] * wi, xi = re[b] * wi + im[b] * wr;
+                    re[b] = re[a] - xr; im[b] = im[a] - xi;
+                    re[a] += xr; im[a] += xi;
+                }
+        }
+        if (inverse) {
+            const double inv = 1.0 / (double)n;
+            for (size_t i = 0; i < n; i++) { re[i] *= inv; im[i] *= inv; }
+        }
+    }
+    void setSecret(const std::vector<int8_t>& s) {
+        sRe.assign(N, 0.0); sIm.assign(N, 0.0);
+        for (size_t k = 0; k < N && k < s.size(); k++) { sRe[k] = (double)s[k] * twRe[k]; sIm[k] = (double)s[k] * twIm[k]; }
+        fft(sRe, sIm, false);
+    }
+    static double centeredFrac(uint64_t v, uint64_t q0, uint64_t halfQ, double invQ) {
+        if (v >= q0) v %= q0;
+        return v > halfQ ? -(double)(q0 - v) * invQ : (double)v * invQ;
+    }
+    // c0, c1: N residues mod q0 in COEFFICIENT representation, natural order.
+    Stats overflow(const uint64_t* c0, const uint64_t* c1, uint64_t q0) {
+        Stats st;
+        const uint64_t halfQ = q0 >> 1;
+        const double invQ = 1.0 / (double)q0;
+        for (size_t k = 0; k < N; k++) {
+            if (c0[k] >= q0 || c1[k] >= q0) st.nonCanon++;   // the device lift (SwitchModulus) assumes words in [0, q0): expect 0
+            const double a = centeredFrac(c1[k], q0, halfQ, invQ);
+            aRe[k] = a * twRe[k]; aIm[k] = a * twIm[k];
+        }
+        fft(aRe, aIm, false);
+        for (size_t k = 0; k < N; k++) {
+            const double pr = aRe[k] * sRe[k] - aIm[k] * sIm[k], pm = aRe[k] * sIm[k] + aIm[k] * sRe[k];
+            aRe[k] = pr; aIm[k] = pm;
+        }
+        fft(aRe, aIm, true);
+        double sumSq = 0.0;
+        for (size_t k = 0; k < N; k++) {
+            const double x = centeredFrac(c0[k], q0, halfQ, invQ) + (aRe[k] * twRe[k] + aIm[k] * twIm[k]);
+            const double r = std::nearbyint(x);
+            const double f = std::fabs(x - r);
+            const long long ai = (long long)std::fabs(r);
+            if (ai > st.maxI) st.maxI = ai;
+            if (ai > 512) st.over512++;
+            if (f > st.maxFrac) st.maxFrac = f;
+            sumSq += r * r;
+        }
+        st.rmsI = std::sqrt(sumSq / (double)N);
+        return st;
+    }
+};
